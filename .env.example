# Iconic Rentals — Supabase environment variables (CLI / tooling use)
#
# This site ships as a static site with no server-side build step, so
# these variables are NOT read by the public website — the browser-facing
# config lives in js/booking-config.js instead (see CLIENT_SETUP.md,
# "Environment Variables"), and that file is unaffected by this one.
# This file is for the Supabase CLI (supabase/config.toml references some
# of these via env()) and any future Node-based tooling — migration
# helpers, seed scripts, admin scripts — none of which exist yet.
#
# Copy this file to .env and fill in the blank values locally.
# .env is git-ignored; never commit real secrets.

# --- Connected project ---
# Not secret. A Supabase project ref and URL are meant to be public — see
# CLIENT_SETUP.md's "Environment Variables" section for why — so these are
# pre-filled for convenience since this project is already connected.
SUPABASE_PROJECT_REF=slokljslqyanbqabvzkk
SUPABASE_URL=https://slokljslqyanbqabvzkk.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNsb2tsanNscXlhbmJxYWJ2emtrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUwMTE5NzIsImV4cCI6MjEwMDU4Nzk3Mn0.jV0v5ql8vBDdHiPJfMTmLfxcB8lOWCGpkjqKzozopew

# --- Real secrets — always blank in version control ---

# Personal access token for `supabase link`, `supabase db push`, etc. from
# the CLI. Generate one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# The database password set when the project was created (Settings >
# Database). Only needed for a direct Postgres connection string.
SUPABASE_DB_PASSWORD=

# service_role key — bypasses Row Level Security entirely. NEVER put this
# in js/booking-config.js or any other file the browser loads. Reserved
# for trusted server-side tooling only, if a future phase ever needs one.
# Find it in Settings > API.
SUPABASE_SERVICE_ROLE_KEY=
